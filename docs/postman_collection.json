              "host": ["{{baseUrl}}"],
              "path": ["listings", "999999"]
            },
            "description": "Mavjud bo'lmagan id. 404 qaytishi KERAK.\n\nAgar 500 qaytsa — service'da `if listing is None` tekshiruvi yo'q."
          },
          "response": []
        },
        {
          "name": "Update listing",
          "event": [
            {
              "listen": "test",
