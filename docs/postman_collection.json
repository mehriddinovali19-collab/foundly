              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            },
            "description": "Faqat e'lon egasi. Begona e'lon bo'lsa -> 403.\n\nPATCH — faqat yuborilgan maydon yangilanadi. `description` o'zgarmasligi kerak (`exclude_unset=True`)."
          },
          "response": []
